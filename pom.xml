<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.scijava</groupId>
        <artifactId>pom-scijava</artifactId>
        <version>44.0.0</version>
        <relativePath />
    </parent>

    <groupId>net.andmccall</groupId>
    <artifactId>Batch_3D_Registration</artifactId>
    <version>1.0-SNAPSHOT</version>

    <name>Batch 3D Registration</name>
    <description>SciJava plugin for fully automatic batched registration of 3D images</description>
    <url>https://github.com/SnowySpider/Batch_3D_Registration</url>
    <inceptionYear>2026</inceptionYear>
    <organization>
        <name>University at Buffalo - Optical Imaging and Analysis Facility</name>
        <url>http://dental.buffalo.edu/research/centers-and-facilities/optical-imaging-and-analysis.html</url>
    </organization>
    <licenses>
        <license>
            <name>GNU General Public License (GPL)</name>
            <url>http://www.gnu.org/licenses/gpl.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>andmccall</id>
            <name>Andrew McCall</name>
            <url>https://imagej.net/User:Amccall</url>
        </developer>
    </developers>
    <contributors>
        <contributor>
            <name>None</name>
        </contributor>
    </contributors>

    <mailingLists>
        <mailingList>
            <name>Image.sc Forum</name>
            <archive>https://forum.image.sc/tag/imagej</archive>
        </mailingList>
    </mailingLists>

    <scm>
        <connection>scm:git:git://github.com/SnowySpider/Batch_3D_Registration</connection>
        <developerConnection>scm:git:git@github.com:SnowySpider/Batch_3D_Registration</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/SnowySpider/Batch_3D_Registration</url>
    </scm>
    <issueManagement>
        <system>GitHub Issues</system>
        <url>http://github.com/SnowySpider/Batch_3D_Registration/issues</url>
    </issueManagement>
    <ciManagement>
        <system>None</system>
    </ciManagement>

    <properties>

        <main-class>batch3Dregistration.Batch_3D_Registration</main-class>
        <license.licenseName>gpl_v3</license.licenseName>
        <license.copyrightOwners>Andrew McCall, University at Buffalo</license.copyrightOwners>

        <releaseProfiles>deploy-to-scijava</releaseProfiles>

        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    </properties>

    <repositories>
        <repository>
            <id>scijava.public</id>
            <url>https://maven.scijava.org/content/repositories/public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>net.imagej</groupId>
            <artifactId>imagej</artifactId>
            <version>2.18.0</version>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
            <version>4.13.2</version>
        </dependency>

        <dependency>
            <groupId>net.imglib2</groupId>
            <artifactId>imglib2-algorithm-gpl</artifactId>
            <version>0.3.1</version>
        </dependency>

        <dependency>
            <groupId>org.scijava</groupId>
            <artifactId>scijava-legacy</artifactId>
            <version>1.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.scijava</groupId>
            <artifactId>scijava-ops-image</artifactId>
            <version>1.0.0</version>
        </dependency>

    </dependencies>

</project>